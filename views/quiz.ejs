    <script>  

// Array of question objects

const questions = JSON.parse('<%-JSON.stringify(questions)%>')
const hours = Number.parseInt(JSON.parse('<%-JSON.stringify(hours)%>'))
const mins = Number.parseInt(JSON.parse('<%-JSON.stringify(mins)%>'))
const quizData = questions.map((pair)=>{
  return {
    ques_no: "Ques"+(questions.indexOf(pair)+1),
    statement: pair.question,
    options: [
      pair.optionA,
      pair.optionB,
      pair.optionC,
      pair.optionD
    ]
  }
})
let answers = questions.map(()=>{
  return ""
})
