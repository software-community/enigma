// Current question index
let currentQuestionIndex = 0;

// Function to render a single question based on index
function renderQuiz() {
  const container = document.getElementById("add_here");
  container.innerHTML = ""; // Clear previous question

  const question = quizData[currentQuestionIndex];

  // Create a container div for the question
  const questionDiv = document.createElement("div");
  questionDiv.className = "question";

  // Create question number element
  const quesNo = document.createElement("h1");
  quesNo.className = "ques_no";
  quesNo.textContent = question.ques_no;
  questionDiv.appendChild(quesNo);

  // Create question statement
  const statementDiv = document.createElement("div");
  statementDiv.className = "statement";
  statementDiv.textContent = question.statement;
  questionDiv.appendChild(statementDiv);

  // Create options container
  const optionsDiv = document.createElement("div");
  optionsDiv.className = "option_s";

  question.options.forEach((optionText, oIndex) => {
    const optionId = `option_${currentQuestionIndex + 1}_${oIndex + 1}`;
    const optionName = `opt_${currentQuestionIndex + 1}`;

    const label = document.createElement("label");
    label.setAttribute("for", optionId);

    const optionDiv = document.createElement("div");
    optionDiv.className = `option${oIndex + 1} option`;

    const radioInput = document.createElement("input");
    radioInput.type = "radio";
    radioInput.id = optionId;
    radioInput.name = optionName;
    radioInput.className = "bait";
    radioInput.addEventListener('change', () => {
      let choiceMap = ['A','B','C','D'] 
      let chosen_num = Number.parseInt((radioInput.id).slice(9))
      console.log(Number.parseInt((radioInput.name).slice(4))-1)
      console.log(choiceMap[chosen_num-1])
      answers[Number.parseInt((radioInput.name).slice(4))-1] = choiceMap[chosen_num-1]
      });

    optionDiv.appendChild(radioInput);
    optionDiv.appendChild(document.createTextNode(" " + optionText));

    label.appendChild(optionDiv);
    optionsDiv.appendChild(label);
  });

  questionDiv.appendChild(optionsDiv);
  container.appendChild(questionDiv);
}

// Function to navigate between questions
function showQuestion(index) {
  if (index >= 0 && index < quizData.length) {
    currentQuestionIndex = index;
    renderQuiz(); // Rerender quiz with new question
  }
}

// Set up navigation buttons
function setupNavigation() {
  document.getElementById("prevBtn").addEventListener("click", function (event) {
    event.preventDefault();
    if (currentQuestionIndex > 0) {
      showQuestion(currentQuestionIndex - 1);
    }
  });

  document.getElementById("nextBtn").addEventListener("click", function (event) {
    event.preventDefault();
    if (currentQuestionIndex < quizData.length - 1) {
      showQuestion(currentQuestionIndex + 1);
    }
  });
}

// Initialize the quiz on page load
document.addEventListener("DOMContentLoaded", function () {
  renderQuiz();
  setupNavigation();
});

// Function to start the timer

    // Set the exam duration in seconds (e.g., 60 minutes = 3600 seconds)
    if((hours*3600 + mins*60) > 0){
    const examDuration = hours*3600 + mins*60; // Adjust this value as needed

    function startExamTimer(duration, display) {
    let timer = duration;
    const intervalId = setInterval(() => {
        // Calculate minutes and seconds
        const minutes = Math.floor(timer / 60);
        const seconds = timer % 60;

        // Format time with leading zeros
        display.textContent = 
        (minutes < 10 ? "0" + minutes : minutes) + ":" +
        (seconds < 10 ? "0" + seconds : seconds);

        // Stop the timer when it reaches zero
        if (--timer < 0) {
        clearInterval(intervalId);
        display.textContent = "00:00";
        document.getElementById('message').textContent = "Time's up!";
        // Optional: Add exam submission or auto-save logic here
        }
    }, 1000);
    }

    // Start the timer when the page loads
    window.onload = function() {
    setTimeout(()=>document.getElementById('submit').click(),(hours*3600 + mins*60)*1000)
    const timerDisplay = document.getElementById('timer');
    startExamTimer(examDuration, timerDisplay);
    };
  }

    // document.getElementById('submit').addEventListener('click',(e)=>{
    //   e.preventDefault()
    //   console.log(answers)
    // })

    document.getElementById('submit').addEventListener('click',async (e)=>{
            e.preventDefault()
            let takenId = Date.now()
            let length = Number.parseInt('<%-questions.length%>')
            let response = await fetch('/quizes/check',{
                method:"post",
                headers:{
                     'Content-Type': 'application/json'
                },
                body:JSON.stringify({answers, name: '<%-name%>', quizId: '<%-quizId%>', takenId})
            })
            
            let goToStats = document.createElement('form')
            goToStats.setAttribute('method','post')
            goToStats.setAttribute('action','/quizes/stats')
            goToStats.hidden = true
            goToStats.insertAdjacentHTML('afterbegin',`<input
                    type="text"
                    name="quizId"
                    id="quizId"
                    value="<%=quizId%>"
                  />`)
            document.body.appendChild(goToStats)
            goToStats.submit()
            console.log("reached here")
        })
    </script>
</body>
