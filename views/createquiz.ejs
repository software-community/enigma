                      placeholder="Enter Quiz Time"
                      class="questionInput"
                      required
                    />
                  </div>
                  <div class="quiz-info-slide-horizontal">
                    <h2>Duration:</h2>
                    <input
                      type="text"
                      id="quizDuration"
                      placeholder="Enter Quiz Duration"
                      class="questionInput"
                      required
                    />
                  </div>
                  <div class="quiz-info-slide-horizontal">
                    <h2>Image:</h2>
                    <input type="file" id="quizImage" class="questionInput-image" accept="image/*" required />
                    <label for="quizImage"></label>
                </div>
                <div class="quiz-info-slide-horizontal">
                  <h2>No. Of Questions:</h2>
                  <input
                    type="number"
                    id="NumQuestions"
                    placeholder="Enter The Number Of Questions (click SAVE CHANGES)"
                    class="questionInput"
                    min="1"
                    required
                  />
                </div>
              </br>
                <div class="quiz-info-slide-horizontal-button">
                  <button
                    id="addQuestions"
                    type="button"
                  >
                    SAVE CHANGES
                  </button>
                </div>
            </br>
