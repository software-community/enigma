<script>document.addEventListener("DOMContentLoaded", function () {
  const quizWrapper = document.getElementById("quiz-wrapper");
  const nextBtn = document.getElementById("nextBtn");
  const prevBtn = document.getElementById("prevBtn");
  let currentSlideIndex = 0;

  // Function to show a specific slide
  function showSlide(index) { 
    const slides = document.querySelectorAll(".quiz-slide");
    if (index >= slides.length) index = 0; // Loop to the first slide
    if (index < 0) index = slides.length - 1; // Loop to the last slide

    // Hide all slides
    slides.forEach((slide) => (slide.style.display = "none"));

    // Show the current slide
    slides[index].style.display = "block";
    slides[index].scrollIntoView({ behavior: "smooth", block: "center" });

    currentSlideIndex = index;

    // Disable/enable buttons based on the current slide
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === slides.length - 1;
}


  // Function to generate questions
  function generateQuestions() {
      const numQuestions = parseInt(document.getElementById("NumQuestions").value, 10);

      // Validate the number of questions
      if (numQuestions < 1) {
          alert("Please enter a valid number of questions.");
          return;
      }

      // Clear existing slides (except the setup slide)
      const slides = document.querySelectorAll(".quiz-slide");
      slides.forEach((slide, index) => {
          if (index !== 0) {
              slide.remove(); // Remove all slides except the setup slide
          }
      });

      // Generate new slides
      for (let i = 1; i <= numQuestions; i++) {
          let slide = document.createElement("div");
          slide.className = "quiz-slide";
          slide.innerHTML = `
        <h1>Question ${i}</h1>
        <input type="text" class="questionInput" id="Question${i}" placeholder="Enter Question ${i}" required />
        ${["A", "B", "C", "D"]
          .map(
              (opt) => `
          <div class="option">
            <button id="Q${i}-option${opt}" class="optionLetters">${opt}</button>
            <input type="text" id="Q${i}-option${opt}-input" placeholder="Option ${opt}" required />
          </div>
        `
          )
          .join("")}
      `;
          quizWrapper.appendChild(slide);
      }

      // Attach event listeners to the newly created buttons
      attachButtonListeners();

      // Show the first question slide
      showSlide(1); // Skip the setup slide (index 0)
  }

  // Function to attach event listeners to buttons
  function attachButtonListeners() {
      const buttons = document.querySelectorAll(".optionLetters");

      buttons.forEach((button) => {
          button.addEventListener("click", function () {
              const input = this.nextElementSibling; // Get corresponding input field

              if (input && input.tagName.toLowerCase() === "input") {
                  // Extract question ID (e.g., "Q1-optionA" → "Q1")
                  const questionId = this.id.split("-")[0];

                  // Remove 'glow' from all inputs in this question
                  document
                      .querySelectorAll(`input[id^='${questionId}-']`)
                      .forEach((inp) => {
                          inp.classList.remove("glow");
                      });

                  // Remove 'optionLetters-clicked' from all buttons in this question
                  document
                      .querySelectorAll(`.optionLetters[id^='${questionId}-']`)
                      .forEach((btn) => {
                          btn.classList.remove("optionLetters-clicked");
                      });

                  // Highlight the selected input
                  input.classList.add("glow");

                  // Highlight the selected button
                  this.classList.add("optionLetters-clicked");

                  // Automatically focus on the input field
                  input.focus();
              }
          });
      });
  }

  // Event listener for the "Add Questions" button
  document.getElementById("addQuestions").addEventListener("click", generateQuestions);

  // Event listener for the "Next" button
  nextBtn.addEventListener("click", () => {
      showSlide(currentSlideIndex + 1);
  });

  // Event listener for the "Previous" button
  prevBtn.addEventListener("click", () => {
      showSlide(currentSlideIndex - 1);
  });

  // Touch swipe functionality
  let touchStartX = 0;
  let touchEndX = 0;
  quizWrapper.addEventListener("touchstart", (e) => {
      touchStartX = e.touches[0].clientX;
  });

  quizWrapper.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].clientX;

      if (touchStartX > touchEndX + 50) {
          showSlide(currentSlideIndex + 1); // Swipe left
      } else if (touchStartX < touchEndX - 50) {
          showSlide(currentSlideIndex - 1); // Swipe right
      }
  });

  // Show the initial setup slide
  showSlide(currentSlideIndex);
});


  </script>
