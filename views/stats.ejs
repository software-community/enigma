<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stats</title>
    <link href="https://fonts.googleapis.com/css2?family=Itim&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/stats.css">
    <link rel="stylesheet" href="../css/host_stats.css">
    <link
    href="https://cdn.jsdelivr.net/npm/remixicon@4.5.0/fonts/remixicon.css"
    rel="stylesheet"/>
</head>
<body>
    <!-- topbar -->
    <div>
        <div class="navbar">
            <a href="/"> <img src="../common_assets/enigma-logo.jpg" alt="enigma-logo"> </a>
            <h1>Quiz Result</h1>
            <form id="logoutform" action="/auth/logout">
            <button id="logout">Logout</button>
        </form> 
        </div>
    </div>

    <!-- quiz headings -->
    <div id="left">
        <div id="matter">
    <h1 class="quizname"><%=myQuizTaken.quiz.name%></h1>
        <div class="quiz">
            <h2 class="quizthings" id="quiz_date">Given : <%=myQuizTaken.date%></h2>
            <h2 class="quizthings" id="quiz_date">Score : <%=myQuizTaken.score%></h2>
            <h2 class="quizthings" id="quiz_rank">Rank : <%=leaderboard.findIndex(taker => taker.name === username) + 1%></h2>
            <h2 class="quizthings" id="participants">Total participants: <%=leaderboard.length%></h2>
        </div>
        </div>
    </div>

    <!-- charts -->

    <div id="right" >

    <!-- chart for time analysis-->

        <!-- <div class="time_wise">
            <div class="plot">
            <canvas id="Time_plot"></canvas> 
        </div>
        </div> -->
        <div class="ranklist">
            <table id="list">
                <tr>
                    <th>Name</th>
                    <th>Rank</th>
                    <th>Score</th> 
                </tr>
                <% if(leaderboard) { %>
                    <% for(let taker of leaderboard){%>
                        <tr>
                            <td><%=taker.name%></td>
                            <td><%=(leaderboard).indexOf(taker)+1%></td>
                            <td><%=taker.score%></td>
                        </tr>
                    <%}%>
                    <%}%>
            </table>
    
            <!-- icons for navigation in rank list -->
            <div class="icon">
            <div id="prev_page"><h1> <i class="ri-arrow-left-circle-line"></i> prev page</h1></div>
            <div id="next_page"><h1>next page <i class="ri-arrow-right-circle-line"></i></h1></div>
            </div>
            </div>

        <div class="question_wise">
            <h1>Question wise analysis</h1>
            <div id="question_s">
            </div>
        </div>
    </div>


    

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        
        const myQuizTaken = JSON.parse(`<%- JSON.stringify(myQuizTaken) %>`)
        const quiz = myQuizTaken.quiz
        const answers = myQuizTaken.answers
        let data = []
        for(let i=0;i<answers.length;i++)
             data.push({ sn: i+1, time: Math.ceil(Math.random()*25), verdict: quiz.qna[i].correctOption == answers[i]? "correct" : "incorrect", statement: quiz.qna[i].question, option: `A) ${quiz.qna[i].optionA}, B) ${quiz.qna[i].optionB}, C) ${quiz.qna[i].optionC}, D) ${quiz.qna[i].optionD}`, response: answers[i], answer: quiz.qna[i].correctOption })

        console.log(data)
        const sns = data.map(item => item.sn);
        const times = data.map(item => item.time);
        const backgroundColors = data.map(item => 
            item.verdict === "correct" ? 'rgba(95, 252, 0, .7)' : 'rgba(255, 20, 9, .6)'
        );

        // var ctx = document.getElementById('Time_plot').getContext('2d');
        // var plot = new Chart (ctx , {
        //     type : 'bar', 
        //     data : {
        //         labels : sns, 
        //         datasets : [
        //             {
        //                 label: "Time taken ",
        //                 data : times,
        //                 backgroundColor : backgroundColors,
        //                 borderWidth: .5,
        //             },{
        //                 label: "Trend Line",
        //                 type: 'line',
        //                 data : times,
        //                 borderColor : 'rgba(20, 30 , 240, 1)',
        //                 borderWidth : 2.5,
        //                 fill: false
        //             }
        //         ]
        //     }, 
        //     options : {
        //         responsive : false ,
        //         plugins: {
        //             legend: {
        //                 position: 'top'
        //             }
        //         },
        //         scales: {
        //             x: {
        //                 title: {
        //                     display: true, 
        //                     text: 'Question number'
        //                 }
        //             },
        //             y:{
        //                 beginAtZero: true,
        //                 title : {
        //                     display : true,
        //                     text : 'Time taken'
        //                 }
        //             }
        //         }
        //     }
        // })

     

        var container = document.getElementById("question_s");

        for (i of data) {
            var question = document.createElement('div'); 
            question.className = "question";
            question.innerHTML = `<sn>${i.sn}</sn> <h4>${i.statement}</h4> <br>${i.option} <h3>Your answer: ${i.response}</h3> <h3>Correct answer: ${i.answer}</h3>`; 
            // console.log(`${i.verdict}`);
            question.style.backgroundColor =  (i.verdict === "correct" ? 'rgba(95, 252, 0, .65)' : 'rgba(255, 20, 9, .45)');
            container.append(question); 
        }

    </script>
    
</body>
</html>