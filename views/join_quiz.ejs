<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join Quiz</title>

</head>
<body>

    <%- include('navbar') %>
    <br>
    <div class="join-quiz-page">
        <div class="join-quiz-container">
            <div class="join-quiz-title">
                Joining a quiz
            </div>
            <div class="join-quiz-input">
                Enter your code:
                <input type="text" id="quizId">
            </div>
            <div id="error" class="not-found-message">
                
              </div>
            <input id="submit" type="submit" class="join-quiz-button" value="Join Quiz">
        </div>
    </div>
    <script>
        document.getElementById('submit').onclick = async (e)=>{
            e.preventDefault()
            const quizId = document.getElementById('quizId').value
            const response = await fetch('/quizes/joinQuiz',{
                method:"post",
                headers: {
                "Content-Type": "application/json"
                },
                body: JSON.stringify({ quizId: quizId })
            })
            if(response.status==200){
                const quizDetails = await response.json()
                let myform = document.createElement('form')
                myform.setAttribute('action','/quizes/startquiz')
                myform.setAttribute('method','post')
                myform.innerHTML = `<input id="quizId" name="quizId" type="text" value="${quizDetails.quizId}">
                    <input id="quizname" name="quizname" type="text" value="${quizDetails.quizname}">`
                myform.hidden = true
                document.body.appendChild(myform)
                myform.submit()
            }
            else
            document.getElementById('error').innerHTML = "No quiz found with this code"
        }
    </script>
</body>
</html>