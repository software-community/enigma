<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homepage</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="css/style_dashboard.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Itim&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<body>
    
    <%- include('navbar') %>

    <div class="mainline">
        Upcoming Quizzes
    </div>
    
    <div class="upcomingQuizzes">
        <div id="container1">
            <div class="quiz1">
                <img id="q1i1" src="dashboard_assets/pokemon-quiz.jpg" alt="pokemon-quiz">
                <img id="q1i2" src="dashboard_assets/quiz1.jpg" alt="quiz1">
                <a href="#">
                    <button class="register">
                        <i class="fa-solid fa-file-pen"></i>
                        Register
                    </button>
                </a>
            </div>
            <div class="quiz2">
                <img id="q2i1" src="dashboard_assets/marvel.jpg" alt="marvel">
                <img id="q2i2" src="dashboard_assets/marvel-quiz.jpg" alt="marvel-quiz">
                <a href="#">
                    <button class="register">
                        <i class="fa-solid fa-file-pen"></i>
                        Register
                    </button>
                </a>
            </div>
        </div>
    </div>
    <br>
    <div class="mainline2">
        Featured Quizzes
    </div>
    <% if(featuredQuizes) { %>
    <div class="featuredQuizzes">
        <% for(let quiz of featuredQuizes) { %>
            <div id="fquiz<%=featuredQuizes.indexOf(quiz)+1%>" class="fquiz">
                <div class="fquizTitleBox">
                    <div class="fquizTitle"><%=quiz.quizname%></div>
                    <div class="fquizDate">Held on XX-XX-20XX</div>
                    <form id="<%=quiz.quizId%>" action="/quizes/startquiz" method="post" hidden>
                        <input id="quizId" name="quizId" type="text" value="<%=quiz.quizId%>">
                        <input id="quizname" name="quizname" type="text" value="<%=quiz.quizname%>">
                    </form>
                    <a href="quiz" onclick="document.getElementById('<%=quiz.quizId%>').submit(); return false;"><button class="takeQuiz">Take Quiz</button></a>
                </div>
            </div>
            <% } %>
    </div>
    <% } %>
    <script src="/script/script_dashboard.js"></script>

    <div class="separator2">
        |
    </div>
</body>
</html>